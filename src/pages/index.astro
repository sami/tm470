---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Trade Materials Calculator">
  <h1>Trade Materials Calculator</h1>
  <p>
    Type in a job's measurements and get a list of the materials it needs, with a quantity
    against each one. Masonry walls first.
  </p>
  <p><a href={base + '/masonry-wall/'}>Open the masonry wall calculator</a></p>
</Base>
